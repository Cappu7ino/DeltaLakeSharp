<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>DeltaLakeSharp.Benchmark</RootNamespace>
    <AssemblyName>DeltaLakeSharp.Benchmark</AssemblyName>
    <TargetFrameworks>net472;net8.0</TargetFrameworks>
    <PlatformTarget Condition="'$(TargetFramework)' == 'net472' and '$(PlatformTarget)' == ''">x64</PlatformTarget>
    <OutputType>Exe</OutputType>
    <StartupObject>DeltaLakeSharp.Benchmark.Program</StartupObject>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Disable entry point generation as this project has its own entry point -->
    <GenerateProgramFile>false</GenerateProgramFile>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RustV3ProjectDir>$(MSBuildThisFileDirectory)..\..\src\DeltaLakeSharp.Server\v3</RustV3ProjectDir>
    <RustCargoProfile Condition="'$(Configuration)' == 'Release'">release</RustCargoProfile>
    <RustCargoProfile Condition="'$(RustCargoProfile)' == ''">debug</RustCargoProfile>
    <UseNativeRustForBenchmark Condition="'$(UseNativeRustForBenchmark)' == ''">true</UseNativeRustForBenchmark>
    <RustTargetCpu Condition="'$(Configuration)' == 'Release' and '$(UseNativeRustForBenchmark)' == 'true' and '$(RustTargetCpu)' == ''">native</RustTargetCpu>
    <RustNativeLibraryName Condition="$([MSBuild]::IsOSPlatform('Windows'))">delta_table_service_native.dll</RustNativeLibraryName>
    <RustNativeLibraryName Condition="$([MSBuild]::IsOSPlatform('OSX'))">libdelta_table_service_native.dylib</RustNativeLibraryName>
    <RustNativeLibraryName Condition="$([MSBuild]::IsOSPlatform('Linux'))">libdelta_table_service_native.so</RustNativeLibraryName>
    <RustNativeRuntimeIdentifier Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</RustNativeRuntimeIdentifier>
    <RustNativeRuntimeIdentifier Condition="'$(RustNativeRuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-x64</RustNativeRuntimeIdentifier>
    <RustNativeRuntimeIdentifier Condition="'$(RustNativeRuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('OSX')) and '$(PlatformTarget)' == 'arm64'">osx-arm64</RustNativeRuntimeIdentifier>
    <RustNativeRuntimeIdentifier Condition="'$(RustNativeRuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('OSX')) and '$(PlatformTarget)' == 'x64'">osx-x64</RustNativeRuntimeIdentifier>
    <RustNativeRuntimeIdentifier Condition="'$(RustNativeRuntimeIdentifier)' == '' and '$(PlatformTarget)' == '' and '$(NETCoreSdkRuntimeIdentifier)' != ''">$(NETCoreSdkRuntimeIdentifier)</RustNativeRuntimeIdentifier>
    <RustNativeRuntimeIdentifier Condition="'$(RustNativeRuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">linux-x64</RustNativeRuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="Apache.Arrow" Version="22.1.0" />
    <PackageReference Include="Apache.Arrow.Adbc" Version="0.22.0" />
    <PackageReference Include="Apache.Arrow.Flight" Version="22.1.0" />
    <PackageReference Include="Azure.Identity" Version="1.11.4" />
    <PackageReference Include="Google.Protobuf" Version="3.34.0" />
    <PackageReference Include="BenchmarkDotNet.Diagnostics.Windows" Version="0.15.8" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DeltaLakeSharp.Adbc\DeltaLakeSharp.Adbc.csproj"
                      AdditionalProperties="RustTargetCpu=$(RustTargetCpu)" />
    <ProjectReference Include="..\..\src\DeltaLakeSharp.Client\DeltaLakeSharp.Client.csproj"
                      AdditionalProperties="RustTargetCpu=$(RustTargetCpu)" />
    <ProjectReference Include="..\..\src\DeltaLakeSharp.Testing\DeltaLakeSharp.Testing.csproj" />
  </ItemGroup>

  <!-- Copy DeltaLakeSharp.Server files to output so Docker build context is available at runtime -->
  <ItemGroup>
    <Content Include="..\..\src\DeltaLakeSharp.Server\**\*"
             Exclude="..\..\src\DeltaLakeSharp.Server\.vs\**;..\..\src\DeltaLakeSharp.Server\__pycache__\**;..\..\src\DeltaLakeSharp.Server\v3\target\**"
             Link="DeltaLakeSharp.Server\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             Visible="false" />
    <Content Include="TestData\**\*"
             Link="TestData\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             Visible="false" />
    <Content Include="$(RustV3ProjectDir)\target\$(RustCargoProfile)\$(RustNativeLibraryName)"
             Link="runtimes\$(RustNativeRuntimeIdentifier)\native\$(RustNativeLibraryName)"
             CopyToOutputDirectory="PreserveNewest"
             Visible="false"
             Condition="'$(UseNativeRustForBenchmark)' == 'true' And '$(RustNativeLibraryName)' != ''" />
  </ItemGroup>
</Project>
