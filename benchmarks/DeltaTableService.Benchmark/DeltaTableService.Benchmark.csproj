<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>DeltaTableService.Benchmark</RootNamespace>
    <AssemblyName>DeltaTableService.Benchmark</AssemblyName>
    <TargetFramework>net8.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <OutputType>Exe</OutputType>
    <StartupObject>DeltaTableService.Benchmark.Program</StartupObject>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Disable entry point generation as this project has its own entry point -->
    <GenerateProgramFile>false</GenerateProgramFile>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DeltaTableService.Client\DeltaTableService.Client.csproj" />
  </ItemGroup>

  <!-- Copy DeltaTableService.Server files to output so Docker build context is available at runtime -->
  <ItemGroup>
    <Content Include="..\..\src\DeltaTableService.Server\**\*" Exclude="..\..\src\DeltaTableService.Server\.vs\**;..\..\src\DeltaTableService.Server\__pycache__\**" Link="DeltaTableService.Server\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
