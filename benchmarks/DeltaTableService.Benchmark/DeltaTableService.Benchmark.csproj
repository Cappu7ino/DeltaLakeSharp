<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>DeltaTableService.Benchmark</RootNamespace>
    <AssemblyName>DeltaTableService.Benchmark</AssemblyName>
    <TargetFrameworks>net472;net8.0</TargetFrameworks>
    <PlatformTarget>x64</PlatformTarget>
    <OutputType>Exe</OutputType>
    <StartupObject>DeltaTableService.Benchmark.Program</StartupObject>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Disable entry point generation as this project has its own entry point -->
    <GenerateProgramFile>false</GenerateProgramFile>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RustV3ProjectDir>$(MSBuildThisFileDirectory)..\..\src\DeltaTableService.Server\v3</RustV3ProjectDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="Apache.Arrow" Version="22.1.0" />
    <PackageReference Include="Apache.Arrow.Flight" Version="22.1.0" />
    <PackageReference Include="Google.Protobuf" Version="3.34.0" />
    <PackageReference Include="BenchmarkDotNet.Diagnostics.Windows" Version="0.15.8" />
    <PackageReference Include="Microsoft.DI.Delta" Version="3.0.2.442" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DeltaTableService.Client\DeltaTableService.Client.csproj" />
    <ProjectReference Include="..\..\src\DeltaTableService.Testing\Microsoft.DI.DeltaTableService.Testing.csproj" />
  </ItemGroup>

  <!-- Copy DeltaTableService.Server files to output so Docker build context is available at runtime -->
  <ItemGroup>
    <Content Include="..\..\src\DeltaTableService.Server\**\*"
             Exclude="..\..\src\DeltaTableService.Server\.vs\**;..\..\src\DeltaTableService.Server\__pycache__\**;..\..\src\DeltaTableService.Server\v3\target\**"
             Link="DeltaTableService.Server\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             Visible="false" />
    <Content Include="TestData\**\*"
             Link="TestData\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             Visible="false" />
    <Content Include="$(RustV3ProjectDir)\target\release\delta_table_service_native.dll"
             Link="runtimes\win-x64\native\delta_table_service_native.dll"
             CopyToOutputDirectory="PreserveNewest"
             Visible="false" />
  </ItemGroup>
</Project>
