<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Microsoft.ADMS.Testing.DeltaTableService.Tests</RootNamespace>
    <AssemblyName>DeltaTableService.Tests</AssemblyName>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RustV3ProjectDir>$(MSBuildThisFileDirectory)..\..\src\DeltaTableService.Server\v3</RustV3ProjectDir>
    <SkipRustBuild Condition="'$(SkipRustBuild)' == ''">false</SkipRustBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="16.5.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="2.1.1" />
    <PackageReference Include="MSTest.TestFramework" Version="2.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DeltaTableService.Client\DeltaTableService.Client.csproj" />
  </ItemGroup>

  <!-- Copy DeltaTableService.Server files to output so Docker build context is available at test time -->
  <ItemGroup>
    <Content Include="..\..\src\DeltaTableService.Server\**\*" Exclude="..\..\src\DeltaTableService.Server\.vs\**;..\..\src\DeltaTableService.Server\__pycache__\**" Link="DeltaTableService.Server\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <Target Name="BuildRustV3Artifacts"
          BeforeTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipRustBuild)' != 'true'">
    <Message Importance="high" Text="Building Rust V3 artifacts via cargo build..." />
    <Exec Command="cargo build"
          WorkingDirectory="$(RustV3ProjectDir)" />
  </Target>
</Project>
