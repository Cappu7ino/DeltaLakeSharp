<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Microsoft.ADMS.Testing.DeltaTableService.Tests</RootNamespace>
    <AssemblyName>DeltaTableService.Tests</AssemblyName>
    <TargetFrameworks>net8.0;net472</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RustV3ProjectDir>$(MSBuildThisFileDirectory)..\..\src\DeltaTableService.Server\v3</RustV3ProjectDir>
    <SkipRustBuild Condition="'$(SkipRustBuild)' == ''">false</SkipRustBuild>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="16.5.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="2.1.1" />
    <PackageReference Include="MSTest.TestFramework" Version="2.1.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DeltaTableService.Client\DeltaTableService.Client.csproj" />
  </ItemGroup>

  <!-- Copy DeltaTableService.Server files to output so Docker build context is available at test time -->
  <ItemGroup>
    <Content Include="..\..\src\DeltaTableService.Server\**\*"
             Exclude="..\..\src\DeltaTableService.Server\.vs\**;..\..\src\DeltaTableService.Server\__pycache__\**;..\..\src\DeltaTableService.Server\v3\target\**"
             Link="DeltaTableService.Server\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             Visible="false" />
  </ItemGroup>

  <Target Name="BuildRustV3ArtifactsForSingleTargetBuild"
          BeforeTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipRustBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true'">
    <Message Importance="high" Text="Building Rust V3 artifacts via cargo build..." />
    <Exec Command="cargo build"
          WorkingDirectory="$(RustV3ProjectDir)" />
  </Target>

  <Target Name="BuildRustV3ArtifactsForCrossTargetBuild"
          BeforeTargets="DispatchToInnerBuilds"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipRustBuild)' != 'true' and '$(IsCrossTargetingBuild)' == 'true'">
    <Message Importance="high" Text="Building Rust V3 artifacts via cargo build..." />
    <Exec Command="cargo build"
          WorkingDirectory="$(RustV3ProjectDir)" />
  </Target>
</Project>
