<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>DeltaLakeSharp.Tests</RootNamespace>
    <AssemblyName>DeltaLakeSharp.Tests</AssemblyName>
    <TargetFrameworks>net8.0;net472</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\src\DeltaLakeSharp.Client\DeltaLakeSharp.Client.snk</AssemblyOriginatorKeyFile>
    <RustV3ProjectDir>$(MSBuildThisFileDirectory)..\..\src\DeltaLakeSharp.Server\v3</RustV3ProjectDir>
    <SkipRustBuild Condition="'$(SkipRustBuild)' == ''">false</SkipRustBuild>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.2.2" />
    <PackageReference Include="MSTest.TestFramework" Version="4.2.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DeltaLakeSharp.Client\DeltaLakeSharp.Client.csproj" />
    <ProjectReference Include="..\..\src\DeltaLakeSharp.Testing\DeltaLakeSharp.Testing.csproj" />
  </ItemGroup>

  <!-- Copy DeltaLakeSharp.Server files to output so Docker build context is available at test time -->
  <ItemGroup>
    <Content Include="..\..\src\DeltaLakeSharp.Server\**\*"
             Exclude="..\..\src\DeltaLakeSharp.Server\.vs\**;..\..\src\DeltaLakeSharp.Server\__pycache__\**;..\..\src\DeltaLakeSharp.Server\v3\target\**"
             Link="DeltaLakeSharp.Server\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             Visible="false" />
  </ItemGroup>

  <Target Name="BuildRustV3ArtifactsForSingleTargetBuild"
          BeforeTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipRustBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true'">
    <Message Importance="high" Text="Building Rust V3 artifacts via cargo build..." />
    <Exec Command="cargo build"
          WorkingDirectory="$(RustV3ProjectDir)" />
  </Target>

  <Target Name="BuildRustV3ArtifactsForCrossTargetBuild"
          BeforeTargets="DispatchToInnerBuilds"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipRustBuild)' != 'true' and '$(IsCrossTargetingBuild)' == 'true'">
    <Message Importance="high" Text="Building Rust V3 artifacts via cargo build..." />
    <Exec Command="cargo build"
          WorkingDirectory="$(RustV3ProjectDir)" />
  </Target>
</Project>
